{
  "schema_version": 1,
  "stack": "expo",
  "project_directory": "apps/expo",
  "profiles": {
    "quick": [
      "lint",
      "typecheck"
    ],
    "full": [
      "lint",
      "typecheck",
      "unit",
      "integration"
    ],
    "e2e": [
      "lint",
      "typecheck",
      "unit",
      "integration",
      "e2e"
    ]
  },
  "checks": {
    "lint": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "typecheck": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "unit": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "test:unit"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "integration": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "test:integration"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "e2e": {
      "directory": "apps/expo",
      "command": [
        "bash",
        "scripts/android-ui-e2e.sh"
      ],
      "timeout_seconds": 240,
      "artifacts": [
        "ci-evidence/android-screen.png",
        "ci-evidence/ui-hierarchy.xml",
        "ci-evidence/activity-start.txt",
        "ci-evidence/package-path.txt",
        "ci-evidence/android-logcat-tail.txt"
      ]
    }
  }
}
