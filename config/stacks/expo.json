{
  "schema_version": 1,
  "stack": "expo",
  "project_directory": "apps/expo",
  "profiles": {
    "quick": [
      "lint",
      "typecheck"
    ],
    "full": [
      "lint",
      "typecheck",
      "unit",
      "integration"
    ],
    "e2e": [
      "lint",
      "typecheck",
      "unit",
      "integration",
      "e2e"
    ]
  },
  "checks": {
    "lint": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "typecheck": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "unit": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "test:unit"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "integration": {
      "directory": "apps/expo",
      "command": [
        "npm",
        "run",
        "test:integration"
      ],
      "timeout_seconds": 300,
      "artifacts": []
    },
    "e2e": {
      "directory": "apps/expo",
      "command": [
        "maestro",
        "test",
        ".maestro",
        "--format",
        "junit",
        "--output",
        "maestro-report.xml"
      ],
      "timeout_seconds": 900,
      "artifacts": [
        "maestro-report.xml",
        "evidence-home.png",
        "**/evidence-home.png"
      ]
    }
  }
}
